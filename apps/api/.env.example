# Copy of the API section of the root .env.example — kept here so
# `dotenv` picks it up when the API runs from this directory.
# See ../../.env.example for full documentation of every variable.

PORT=8787
WEB_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data/oruva.db

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8787/api/auth/x/callback
X_BEARER_TOKEN=
X_ORUVA_USER_ID=
X_FOUNDER_USER_ID=

# Meta OAuth (Instagram + Threads account linking) — Meta app "Oruva Points".
# Never commit real values; set as Railway env vars in production.
THREADS_APP_ID=
THREADS_APP_SECRET=
# THREADS_REDIRECT_URI=  # default: https://apps-api-production-8edb.up.railway.app/api/auth/threads/callback
IG_APP_ID=
IG_APP_SECRET=
# IG_REDIRECT_URI=       # default: https://apps-api-production-8edb.up.railway.app/api/auth/instagram/callback

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
ORVA_MINT=
ORVA_PER_EPOCH=1000000
DISTRIBUTOR_SECRET_KEY=
TREASURY_WALLET=

# Facebook Login (FOLLOW_FACEBOOK verification) — Meta app "Oruva Points"
# with Facebook Login product; user_likes permission needs Meta App Review.
# FB_PAGE_ID is the numeric id of the @Oruvatransport Page.
FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ID=
# FB_REDIRECT_URI=  # default: https://apps-api-production-8edb.up.railway.app/api/auth/facebook/callback
