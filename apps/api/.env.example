# Copy of the API section of the root .env.example — kept here so
# `dotenv` picks it up when the API runs from this directory.
# See ../../.env.example for full documentation of every variable.

PORT=8787
WEB_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data/oruva.db

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8787/api/auth/x/callback
X_BEARER_TOKEN=
X_ORUVA_USER_ID=
X_FOUNDER_USER_ID=

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
ORVA_MINT=
ORVA_PER_EPOCH=1000000
DISTRIBUTOR_SECRET_KEY=
TREASURY_WALLET=
