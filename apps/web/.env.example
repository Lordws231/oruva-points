# Vite loads this automatically. See ../../.env.example for docs.
VITE_API_URL=http://localhost:8787
VITE_SOLANA_CLUSTER=devnet
# Optional — when set, the location picker uses Google Maps; otherwise it
# uses the free OpenStreetMap (Leaflet) fallback with no key or billing.
VITE_GOOGLE_MAPS_API_KEY=
