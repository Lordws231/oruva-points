# ── Oruva Points — copy to apps/api/.env and apps/web/.env ──────────────
# See README.md for how to obtain each value.

# ── API (apps/api/.env) ─────────────────────────────────────────────────
PORT=8787
WEB_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data/oruva.db

# X (Twitter) OAuth 2.0 app — https://developer.x.com → create app → OAuth 2.0
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8787/api/auth/x/callback
# App-level bearer token (for follow verification). Optional: without it the
# API degrades to self-attestation (verified=false).
X_BEARER_TOKEN=
# Numeric X user IDs of the accounts users must follow.
# Resolve via: GET https://api.twitter.com/2/users/by/username/Oruvatransport
#   (Authorization: Bearer $X_BEARER_TOKEN)
X_ORUVA_USER_ID=
X_FOUNDER_USER_ID=

# ── Meta OAuth (Instagram + Threads account linking) ─────────────────────
# Meta app "Oruva Points" (developers.facebook.com): "Access the Threads API"
# use case + "Instagram API with Instagram Login" product. Secrets are set as
# Railway env vars in production; never commit real values here.
THREADS_APP_ID=
THREADS_APP_SECRET=
# THREADS_REDIRECT_URI=  # default: https://apps-api-production-8edb.up.railway.app/api/auth/threads/callback
IG_APP_ID=
IG_APP_SECRET=
# IG_REDIRECT_URI=       # default: https://apps-api-production-8edb.up.railway.app/api/auth/instagram/callback

# ── Solana ──────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet            # devnet | testnet | mainnet-beta
ORVA_MINT=                       # printed by: npm run token:create --workspace apps/api
ORVA_PER_EPOCH=1000000           # ORVA distributed per weekly epoch
DISTRIBUTOR_SECRET_KEY=          # base58 secret key of the distributor wallet (KEEP SECRET)
TREASURY_WALLET=                 # unclaimed allocations return here after the window

# ── WEB (apps/web/.env) ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:8787
VITE_SOLANA_CLUSTER=devnet
# Google Maps JavaScript API key (Cloud Console → enable "Maps JavaScript API")
VITE_GOOGLE_MAPS_API_KEY=

# Facebook Login (FOLLOW_FACEBOOK verification) — Meta app "Oruva Points"
# with Facebook Login product; user_likes permission needs Meta App Review.
# FB_PAGE_ID is the numeric id of the @Oruvatransport Page.
FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ID=
# FB_REDIRECT_URI=  # default: https://apps-api-production-8edb.up.railway.app/api/auth/facebook/callback
